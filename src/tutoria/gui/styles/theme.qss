QWidget {
    color: #e2e8f0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
}

QTextEdit {
    background-color: #fdfeff;
    color: black;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 12px;
}

QPlainTextEdit {
    background-color: #fdfeff;
    color: black;
    font-family: "Consolas", "Cascadia Code", "DejaVu Sans Mono", monospace;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 12px;
}

QPushButton {
    background-color: #000000;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    font-weight: 600;
}

QLineEdit {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 20px;
    selection-background-color: #cfe0fc;
}

QLCDNumber {
   color: black; 
   border: 1px solid #334155;
   border-radius: 8px;
}

QPushButton:hover {
    background-color: rgb(37, 36, 36);
}

QPushButton:pressed {
    background-color: rgb(41, 38, 38);
}

QPushButton:disabled{
      background-color: #555555;  
        color: #aaaaaa;           
        border: 1px solid #333333;
}